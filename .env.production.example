# Production template.
# On the VPS, copy this file to .env and fill real values.
# Never commit the real .env file.

NODE_ENV=production
APP_ROLE=api
API_APP_ROLE=api
EMAIL_WORKER_APP_ROLE=email-worker
SEARCH_WORKER_APP_ROLE=search-worker
API_IMAGE=ttk-backend-api:prod
API_BUILD_TARGET=production
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=https://ttk-services.agency,https://www.ttk-services.agency,https://admin.ttk-services.agency,https://api.ttk-services.agency
FRONTEND_URL=https://ttk-services.agency
TRUST_PROXY=true
LOG_LEVEL=http
LOG_FORMAT=json
REQUEST_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=55432
POSTGRES_INTERNAL_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB_NAME
DOCKER_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB_NAME

REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@redis:6379
DOCKER_REDIS_URL=redis://:PASSWORD@redis:6379

MEILI_HOST=http://meilisearch:7700
DOCKER_MEILI_HOST=http://meilisearch:7700
MEILI_PORT=7700
MEILI_DB_PATH=/meili_data/data.ms
MEILI_ENV=production
MEILI_MASTER_KEY=

STORAGE_ENDPOINT=http://minio:9000
DOCKER_STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_PREFIX=ttk
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=https://api.ttk-services.agency/storage
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_MAX_VIDEO_SIZE_MB=100
STORAGE_PORT=9000
STORAGE_INTERNAL_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_CONSOLE_INTERNAL_PORT=9001

JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

SUPABASE_URL=
SUPABASE_ANON_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=TTK Services
MAIL_BRAND_NAME=TTK Services
MAIL_LOGO_URL=
MAIL_SUPPORT_EMAIL=contact@ttk-services.agency
CONTACT_TO_EMAIL=contact@ttk-services.agency

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=noreply@ttk-services.agency
RESEND_INBOUND_CONTACT_EMAIL=contact@ttk-services.agency
RESEND_NOTIFICATION_TO_EMAIL=

GOOGLE_CLIENT_ID=

ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

CINETPAY_SITE_ID=
CINETPAY_API_KEY=
