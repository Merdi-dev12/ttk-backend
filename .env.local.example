# Copy this file to .env for local development.
# It intentionally contains no production secrets.

NODE_ENV=development
APP_ROLE=api
COMPOSE_ENV_FILE=.env
API_APP_ROLE=api
EMAIL_WORKER_APP_ROLE=email-worker
SEARCH_WORKER_APP_ROLE=search-worker
API_IMAGE=ttk-backend-api:dev
API_BUILD_TARGET=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4200,http://127.0.0.1:4200
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=http
LOG_FORMAT=pretty
REQUEST_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

DB_USER=ttk_admin
DB_PASSWORD=change-me
DB_NAME=ttk_db
DB_PORT=5433
POSTGRES_INTERNAL_PORT=5432
DATABASE_URL=postgresql://ttk_admin:change-me@localhost:5433/ttk_db
DOCKER_DATABASE_URL=postgresql://ttk_admin:change-me@postgres:5432/ttk_db

REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379
DOCKER_REDIS_URL=redis://:change-me-redis@redis:6379

MEILI_HOST=http://localhost:7700
DOCKER_MEILI_HOST=http://meilisearch:7700
MEILI_PORT=7700
MEILI_DB_PATH=/meili_data/data.ms
MEILI_ENV=development
MEILI_MASTER_KEY=change-me-with-at-least-16-characters

STORAGE_ENDPOINT=http://localhost:9000
DOCKER_STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_PREFIX=ttk
STORAGE_ACCESS_KEY=ttk_storage
STORAGE_SECRET_KEY=change-me-storage-password
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_MAX_VIDEO_SIZE_MB=100
STORAGE_PORT=9000
STORAGE_INTERNAL_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_CONSOLE_INTERNAL_PORT=9001

JWT_SECRET=change-me-with-at-least-32-characters-local
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

SUPABASE_URL=
SUPABASE_ANON_KEY=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@ttk-services.local
MAIL_FROM_NAME=TTK Services
MAIL_BRAND_NAME=TTK Services
MAIL_LOGO_URL=
MAIL_SUPPORT_EMAIL=contact@ttk-services.local
CONTACT_TO_EMAIL=contact@ttk-services.local

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=noreply@ttk-services.agency
RESEND_INBOUND_CONTACT_EMAIL=contact@ttk-services.agency
RESEND_NOTIFICATION_TO_EMAIL=

GOOGLE_CLIENT_ID=

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrateur TTK
ADMIN_PASSWORD=change-me-admin-password

CINETPAY_SITE_ID=
CINETPAY_API_KEY=
